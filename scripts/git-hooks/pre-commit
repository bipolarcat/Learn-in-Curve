#!/bin/sh
# Learn in Curve pre-commit.
#
# Legal "Last updated:" enforcement only. The site version is NOT bumped here —
# it is bumped once per production deploy by `npm run deploy` (scripts/deploy.mjs),
# so SITE_VERSION always equals what is actually live on Railway.
#
# Skip legal date: LIC_SKIP_LEGAL_DATE=1 git commit ...
# Manual version:  npm run version:set -- 3.0

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT" || exit 1

if [ "$LIC_SKIP_LEGAL_DATE" != "1" ]; then
  node scripts/bump-legal-dates.mjs || exit 1
fi

exit 0
